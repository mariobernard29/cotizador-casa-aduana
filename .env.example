# Copia este archivo a .env.local y completa los valores (no los subas al repositorio).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Solo servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_APP_TIMEZONE=America/Mazatlan
# Opcional, solo para aplicar migraciones con scripts/db-apply.ts
# SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
